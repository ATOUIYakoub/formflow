# ============================================
# FormFlow API — production environment example
# Copy to .env and fill in real values, or set
# these as Render env vars.
# ============================================

NODE_ENV=production

# API
API_PREFIX=api
CORS_ORIGIN=https://your-app.vercel.app

# Database (Neon Postgres — must include ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Redis (Upstash — use the endpoint host, port 6379, TLS enabled)
REDIS_HOST=your-upstash-host.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your-upstash-password
REDIS_TLS=true

# Auth
JWT_SECRET=replace-with-a-long-random-string

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM="FormFlow <noreply@formflow.io>"