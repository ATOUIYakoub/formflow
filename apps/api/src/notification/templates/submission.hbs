<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>New Form Submission</title>
</head>
<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #f4f4f5; line-height: 1.6;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width: 600px; margin: 40px auto; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);">
    <!-- Header -->
    <tr>
      <td style="background: linear-gradient(135deg, #18181b 0%, #27272a 100%); padding: 32px; text-align: center;">
        <h1 style="margin: 0; color: #ffffff; font-size: 24px; font-weight: 700; letter-spacing: -0.02em;">New Submission Received</h1>
        <p style="margin: 8px 0 0; color: #a1a1aa; font-size: 14px;">Someone just filled out your form</p>
      </td>
    </tr>

    <!-- Form Info -->
    <tr>
      <td style="padding: 32px;">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
          <tr>
            <td style="padding-bottom: 24px; border-bottom: 1px solid #e4e4e7;">
              <h2 style="margin: 0 0 16px; color: #18181b; font-size: 20px; font-weight: 600;">{{formName}}</h2>
              <div style="display: flex; gap: 24px; flex-wrap: wrap; font-size: 13px; color: #71717a;">
                <span><strong>Form:</strong> {{formSlug}}</span>
                <span><strong>Submission ID:</strong> {{submissionId}}</span>
                <span><strong>Submitted:</strong> {{submittedAt}}</span>
              </div>
            </td>
          </tr>
        </table>

        <!-- Answers (filtered: no files) -->
        {{#if answers.length}}
        <h3 style="margin: 0 0 16px; color: #18181b; font-size: 16px; font-weight: 600;">Responses</h3>
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border: 1px solid #e4e4e7; border-radius: 8px; overflow: hidden;">
          {{#each answers}}
          <tr style="border-bottom: 1px solid #e4e4e7;">
            <td style="padding: 16px; background-color: #fafafa; width: 40%; font-weight: 600; color: #3f3f46; font-size: 14px; vertical-align: top;">{{label}}</td>
            <td style="padding: 16px; color: #18181b; font-size: 14px; vertical-align: top; word-break: break-word;">{{value}}</td>
          </tr>
          {{/each}}
        </table>
        {{/if}}

        <!-- CTA Button -->
        <div style="margin-top: 32px; text-align: center;">
          <a href="{{baseUrl}}/dashboard/forms/{{formSlug}}/submissions" style="display: inline-block; background-color: #18181b; color: #ffffff; padding: 14px 28px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 14px; transition: background-color 0.2s;">
            View All Submissions
          </a>
        </div>
      </td>
    </tr>

    <!-- Footer (simplified) -->
    <tr>
      <td style="background-color: #fafafa; padding: 24px 32px; text-align: center; border-top: 1px solid #e4e4e7;">
        <p style="margin: 0; font-size: 12px; color: #a1a1aa;">
          You received this because you own the form "<strong>{{formName}}</strong>".
        </p>
      </td>
    </tr>
  </table>
</body>
</html>