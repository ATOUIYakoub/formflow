generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FieldType {
  TEXT
  EMAIL
  NUMBER
  LONG_TEXT
  SELECT
  RADIO
  CHECKBOX
  DATE
  FILE
}

enum RuleOperator {
  EQUALS
  NOT_EQUALS
  CONTAINS
  GREATER_THAN
  LESS_THAN
  IS_EMPTY
  IS_NOT_EMPTY
}

enum RuleAction {
  SHOW
  HIDE
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String      @map("password_hash")
  name         String?
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  workspaces   Workspace[]

  @@map("users")
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  forms     Form[]

  @@index([ownerId])
  @@map("workspaces")
}

model Form {
  id          String     @id @default(uuid())
  name        String
  description String?
  slug        String?    @unique
  status      FormStatus @default(DRAFT)
  version     Int        @default(1)
  workspaceId String     @map("workspace_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  publishedAt DateTime?  @map("published_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fields      FormField[]
  submissions Submission[]
  rules       FormRule[]
  versions    FormVersion[]

  @@index([workspaceId])
  @@map("forms")
}

model FormField {
  id          String    @id @default(uuid())
  formId      String    @map("form_id")
  type        FieldType
  label       String
  description String?
  placeholder String?
  required    Boolean   @default(false)
  position    Int
  options     Json?     // For SELECT, RADIO, CHECKBOX choices
  validation  Json?     // For min, max, pattern, etc.
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  form        Form               @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers     SubmissionAnswer[]
  sourceRules FormRule[]         @relation("RuleSource")
  targetRules FormRule[]         @relation("RuleTarget")

  @@index([formId])
  @@map("form_fields")
}

model FormRule {
  id            String       @id @default(uuid())
  formId        String       @map("form_id")
  sourceFieldId String       @map("source_field_id")
  operator      RuleOperator
  value         Json?        // Comparison value (ignored for IS_EMPTY / IS_NOT_EMPTY)
  action        RuleAction
  targetFieldId String       @map("target_field_id")
  createdAt     DateTime     @default(now()) @map("created_at")

  form        Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  sourceField FormField @relation("RuleSource", fields: [sourceFieldId], references: [id], onDelete: Cascade)
  targetField FormField @relation("RuleTarget", fields: [targetFieldId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("form_rules")
}

model Submission {
  id             String       @id @default(uuid())
  formId         String       @map("form_id")
  version        Int          // The version number of the form when submitted
  formVersionId  String?      @map("form_version_id") // Exact version snapshot (null for legacy submissions)
  createdAt      DateTime     @default(now()) @map("created_at")

  form        Form        @relation(fields: [formId], references: [id], onDelete: Cascade)
  formVersion FormVersion? @relation(fields: [formVersionId], references: [id], onDelete: SetNull)
  answers     SubmissionAnswer[]

  @@index([formId])
  @@index([formVersionId])
  @@map("submissions")
}

model FormVersion {
  id        String   @id @default(uuid())
  formId    String   @map("form_id")
  version   Int
  // Immutable snapshot: { name, description, fields: [...], rules: [...] }
  snapshot  Json
  createdAt DateTime @default(now()) @map("created_at")

  form        Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@unique([formId, version])
  @@index([formId])
  @@map("form_versions")
}

model SubmissionAnswer {
  id           String   @id @default(uuid())
  submissionId String   @map("submission_id")
  fieldId      String   @map("field_id")
  value        Json     // Flexible to store string, number, array, boolean, etc.
  createdAt    DateTime @default(now()) @map("created_at")

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  field        FormField  @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([fieldId])
  @@map("submission_answers")
}

model FormAnalytics {
  id        String   @id @default(uuid())
  formId    String   @map("form_id")
  date      DateTime @db.Date
  views     Int      @default(0)
  starts    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([formId, date])
  @@index([formId])
  @@map("form_analytics")
}
